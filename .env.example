PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=zyngram_campus_hub
# Optional OpenAI-compatible assistant provider. Leave all blank for built-in study guidance.
# Obtain a valid secret key from your chosen provider; never put it in frontend code.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional; only needed for the one-time MySQL import documented in README.md.
MYSQL_SOURCE_HOST=127.0.0.1
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_DB=zyngram_campus_hub
MYSQL_SOURCE_USER=zyngram_migrator
MYSQL_SOURCE_PASSWORD=replace-with-a-local-migration-password