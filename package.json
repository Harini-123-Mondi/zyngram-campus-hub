{
  "name": "zyngram-campus-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch-path=server/index.js server/index.js",
    "migrate:mysql-to-mongodb": "node server/migrate-mysql-to-mongodb.js",
    "build": "vite build",
    "test": "node --test server/validation.test.js server/api-management.test.js",
    "test:integration": "node --test server/api.integration.test.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.12.0",
    "mysql2": "^3.24.6",
    "pdfkit": "^0.20.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
